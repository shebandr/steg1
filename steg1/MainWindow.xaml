<Window x:Class="steg1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:steg1"
        mc:Ignorable="d"
        Title="MainWindow" Height="750" Width="1000">
    <StackPanel>
        <Border BorderBrush="Black" BorderThickness="0, 0, 0, 2" >
            <StackPanel>
                <Label HorizontalAlignment="Center">Кси ^2</Label>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="calsXi2" Margin="5" Click="CalcX2_Click">Открыть контейнеры и посчитать X^2</Button>
                    <Button x:Name="calcRS" Margin="5" Click="calcRS_Click">Посчитать RS</Button>
                    <Button x:Name="calcAUMP" Margin="5" Click="calcAUMP_Click">Посчитать AUMP</Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="calsXi2Mass" Margin="5" Click="calsXi2Mass_Click">Открыть контейнеры и посчитать X^2</Button>
                    <Button x:Name="calcRSMass" Margin="5" Click="calcRSMass_Click">Посчитать RS</Button>
                    <Button x:Name="calcAUMPMass" Margin="5" Click="calcAUMPMass_Click">Посчитать AUMP</Button>

                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Label x:Name="sizeFileStatus" Width="200" HorizontalAlignment="Center" Height="40"></Label>
                    <Label x:Name="sizeFileStatus2" Width="300" HorizontalAlignment="Center" Height="40"></Label>

                </StackPanel>
           
               
            </StackPanel>
        </Border>
        
        <Border BorderBrush="Black" BorderThickness="0, 0, 0, 0" >
            <StackPanel>
                <Label HorizontalAlignment="Center">Метрики сравнения изображений</Label>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="getFolder" Click="getFolder_Click" Margin="5">Выбрать папку</Button>
                    <Button x:Name="getOriginal" Click="getOriginal_Click" Margin="5">Выбрать оригинал</Button>
                    <Button x:Name="calcMetrics" Click="calcMetrics_Click" Margin="5">Посчитать метрики</Button>
                    <Button x:Name="calcMetrics2" Click="calcMetrics2_Click"  Margin="5">Посчитать место</Button>
                </StackPanel>
                <TextBox Width="1000" Height="600" x:Name="metricsOutput"     FontFamily="Consolas"></TextBox>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
