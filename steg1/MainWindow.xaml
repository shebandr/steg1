<Window x:Class="steg1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:steg1"
        mc:Ignorable="d"
        Title="MainWindow" Height="750" Width="1000">
    <StackPanel>
        <Border BorderBrush="Black" BorderThickness="0, 0, 0, 2" >
            <StackPanel>
                <Label HorizontalAlignment="Center">Внедрение отпечатка пальцев</Label>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="CalcIntegration" Margin="5" Click="CalcIntegration_Click">Внедрить вотермарку в картинку</Button>
                    <Label>ключ:</Label>
                    <TextBox Width="150" x:Name="keyField" ></TextBox>
                    <Label>Число пользователей:</Label>
                    <ComboBox Width="40" x:Name="selectBit1" SelectedIndex="6">
                        <ComboBoxItem>0</ComboBoxItem>
                        <ComboBoxItem>1</ComboBoxItem>
                        <ComboBoxItem>2</ComboBoxItem>
                        <ComboBoxItem>3</ComboBoxItem>
                        <ComboBoxItem>4</ComboBoxItem>
                        <ComboBoxItem>5</ComboBoxItem>
                        <ComboBoxItem>10</ComboBoxItem>
                        <ComboBoxItem>15</ComboBoxItem>
                    </ComboBox>

                </StackPanel>
                <Label HorizontalAlignment="Center">Внедрение отпечатка пальцев</Label>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="CalcExtraction" Margin="5" Click="CalcExtraction_Click">Внедрить вотермарку в картинку</Button>

                    <Label>c:</Label>
                    <TextBox Width="150" x:Name="cField" ></TextBox>

                    <Label>c_real:</Label>
                    <TextBox Width="150" x:Name="c_realField" ></TextBox>
                    

                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Label x:Name="sizeFileStatus" Width="200" HorizontalAlignment="Center" Height="40"></Label>
                    <Label x:Name="sizeFileStatus2" Width="300" HorizontalAlignment="Center" Height="40"></Label>

                </StackPanel>
           
               
            </StackPanel>
        </Border>
        
        <Border BorderBrush="Black" BorderThickness="0, 0, 0, 0" >
            <StackPanel>
                <Label HorizontalAlignment="Center">Метрики сравнения изображений</Label>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="getFolder" Click="getFolder_Click" Margin="5">Выбрать папку</Button>
                    <Button x:Name="getOriginal" Click="getOriginal_Click" Margin="5">Выбрать оригинал</Button>
                    <Button x:Name="calcMetrics" Click="calcMetrics_Click" Margin="5">Посчитать метрики</Button>
                    <Button x:Name="calcMetrics2" Click="calcMetrics2_Click"  Margin="5">Посчитать место</Button>
                </StackPanel>
                <TextBox Width="1000" Height="600" x:Name="metricsOutput"     FontFamily="Consolas"></TextBox>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
