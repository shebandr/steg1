<Window x:Class="steg1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:steg1"
        mc:Ignorable="d"
        Title="MainWindow" Height="750" Width="1000">
    <StackPanel>
        <Border BorderBrush="Black" BorderThickness="0, 0, 0, 2" >
            <StackPanel>
                <Label HorizontalAlignment="Center">Внедрение отпечатков пальцев</Label>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="getBMP" Margin="5" Click="getBMP_Click">Открыть контейнер</Button>
                    <Button x:Name="CalcIntegration" Margin="5" Click="CalcIntegration_Click">Внедрить отпечатки пальцев</Button>
                    <Label>ключ:</Label>
                    <TextBox Width="150" x:Name="keyField" ></TextBox>
                   

                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Label>Число пользователей:</Label>

                    <TextBox Width="150" x:Name="origUsersCountField" >10</TextBox>
                    <Label>Размер коалиции:</Label>

                    <TextBox Width="150" x:Name="origAttackersCountField" >4</TextBox>

                </StackPanel>
      
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Label x:Name="sizeFileStatus" Width="200" HorizontalAlignment="Center" Height="40"></Label>
                    <Label x:Name="sizeFileStatus2" Width="300" HorizontalAlignment="Center" Height="40"></Label>

                </StackPanel>
           
               
            </StackPanel>
        </Border>
        
        <Border BorderBrush="Black" BorderThickness="0, 0, 0, 0" >
            <StackPanel>
                <Label HorizontalAlignment="Center">Метрики сравнения изображений</Label>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="getFolder" Click="getFolder_Click" Margin="5">Выбрать папку</Button>
                    <Button x:Name="getOriginal" Click="getOriginal_Click" Margin="5">Выбрать оригинал</Button>
                    <Button x:Name="calcMetrics" Click="calcMetrics_Click" Margin="5">Посчитать метрики</Button>
                </StackPanel>
                <TextBox Width="1000" Height="600" x:Name="metricsOutput"     FontFamily="Consolas"></TextBox>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
