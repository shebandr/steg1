<Window x:Class="steg1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:steg1"
        mc:Ignorable="d"
        Title="MainWindow" Height="750" Width="800">
    <StackPanel>
        <Border BorderBrush="Black" BorderThickness="0, 0, 0, 2" >
            <StackPanel>
                <Label HorizontalAlignment="Center">Извлечение битовых плоскостей</Label>
                <Button Width="150" Click="SelectFolder_Click" Margin="5">Выбрать папку</Button>
                <Button Click="Button_Click" Width="150" Margin="5">Извлечь плоскости</Button>
            </StackPanel>
        </Border>
        <Border BorderBrush="Black" BorderThickness="0, 0, 0, 2" >
            <StackPanel>
                <Label HorizontalAlignment="Center">Внедрение информации по гистограмме (вариант 1).</Label>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="getTXT" Margin="5" Click="getTXT_Click">Открыть вотермарку</Button>
                    <Button x:Name="getBMP" Margin="5" Click="getBMP_Click">Открыть контейнер</Button>
                    <Button x:Name="getBMPFolder" Margin="5" Click="getFolder_Click">Открыть папку</Button>
                    <Button x:Name="CalcIntegration" Margin="5" Click="CalcIntegration_Click">Внедрить вотермарку в картинку</Button>
                    <Button x:Name="CalcIntegrationAll" Margin="5" Click="CalcIntegrationAll_Click">Внедрить вотермарку во все в папке</Button>

                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Label x:Name="sizeFileStatus" Width="200" HorizontalAlignment="Center" Height="40"></Label>
                    <Label x:Name="sizeFileStatus2" Width="300" HorizontalAlignment="Center" Height="40"></Label>

                </StackPanel>
           
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Label>Укажите число пиков/нулей:</Label>
                    <ComboBox Width="40" x:Name="selectBit1"
                  SelectedIndex="3">
                        <ComboBoxItem>1</ComboBoxItem>
                        <ComboBoxItem>2</ComboBoxItem>
                        <ComboBoxItem>3</ComboBoxItem>
                        <ComboBoxItem>4</ComboBoxItem>
                        <ComboBoxItem>5</ComboBoxItem>
                        <ComboBoxItem>6</ComboBoxItem>
                        <ComboBoxItem>7</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border BorderBrush="Black" BorderThickness="0, 0, 0, 2" >
            <StackPanel>
                <Label HorizontalAlignment="Center">Извлечение вотермарки.</Label>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="getBMP2" Margin="5" Click="getBMP2_Click">Открыть .bmp</Button>
                    <Button x:Name="CalcExtractionLSB" Margin="5" Click="CalcExtraction_Click">Извлечь вотермарку</Button>
                </StackPanel>
              
            </StackPanel>
        </Border>
        <Border BorderBrush="Black" BorderThickness="0, 0, 0, 0" >
            <StackPanel>
                <Label HorizontalAlignment="Center">Метрики сравнения изображений</Label>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="getFolder" Click="getFolder_Click" Margin="5">Выбрать папку</Button>
                    <Button x:Name="getOriginal" Click="getOriginal_Click" Margin="5">Выбрать оригинал</Button>
                    <Button x:Name="calcMetrics" Click="calcMetrics_Click" Margin="5">Посчитать метрики</Button>
                    <Button x:Name="calcMetrics2" Click="calcMetrics2_Click"  Margin="5">Посчитать место</Button>
                </StackPanel>
                <TextBox Width="600" Height="400" x:Name="metricsOutput"     FontFamily="Consolas"></TextBox>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
